# Microsoft Foundry / Azure OpenAI-compatible deployment.
AI_PROVIDER=foundry
AZURE_FOUNDRY_ENDPOINT=https://your-resource.openai.azure.com
AZURE_FOUNDRY_API_KEY=replace_with_your_azure_key
AZURE_FOUNDRY_DEPLOYMENT=gpt-6-astra
AZURE_FOUNDRY_API_VERSION=2024-10-21

# Persistence and Firebase Admin verification.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=traceguard
# Prefer base64 in Docker/local env so the container does not need the JSON file mounted.
FIREBASE_SERVICE_ACCOUNT_JSON_B64=replace_with_base64_service_account_json
TRACEGUARD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Direct DeepSeek remains available as an alternate provider.
DEEPSEEK_API_KEY=replace_with_your_key
DEEPSEEK_MODEL=deepseek-chat

# Optional fallback provider.
OPENROUTER_API_KEY=replace_with_your_key
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free
# Optional trusted worker image overrides (never supplied by repository content)
TRACEGUARD_RUNTIME_IMAGE=traceguard/runtime:local
TRACEGUARD_CODEQL_IMAGE=traceguard/codeql:local
TRACEGUARD_JOERN_IMAGE=traceguard/joern:local
# Public Firebase web configuration belongs in frontend/.env, not service-account keys.
